#!/bin/bash

# Emit paths to .git directories under the given root(s).
# Prefers fd over find for speed.
_find_gitdirs() {
    if command -v fd &>/dev/null; then
        fd --follow --max-depth 3 --hidden --no-ignore --type d --glob '.git' "$@" 2>/dev/null | sed 's|/$||'
    else
        find -L "$@" -maxdepth 3 -name '.git' 2>/dev/null
    fi
}

__switch_repos() {
  local repo_name="$1"

  # Default search roots; override in your shell rc:
  #   export SWITCH_REPOS_ROOTS="$HOME/Projects $HOME/Development $HOME/src"
  local roots="${SWITCH_REPOS_ROOTS:-$HOME/Projects $HOME/Development}"

  if [ "${repo_name}" = "-ls" ]; then
    for root in ${roots}; do
      [ -d "${root}" ] || continue
      _find_gitdirs "${root}" | while IFS= read -r gitdir; do
        local parent="${gitdir%/.git}"
        echo "${parent##*/}"
      done
    done
    return
  fi

  if [ -z "${repo_name}" ]; then
    local repo_root=$(git rev-parse --show-toplevel 2>&1)
    if [[ "${repo_root}" == fatal:* ]]; then
      echo "Could not find repo root. Are you in a git repo?"
    else
      cd "${repo_root}"
    fi
    return
  fi

  # Repo name given: find and cd into it — use targeted search with early termination
  local repo_path
  if command -v fd &>/dev/null; then
    repo_path=$(fd --follow --max-depth 3 --hidden --no-ignore --type d --full-path --glob "**/${repo_name}/.git" ${roots} 2>/dev/null | sed 's|/$||' | head -n 1)
  else
    repo_path=$(find -L ${roots} -maxdepth 3 -path "*/${repo_name}/.git" -print -quit 2>/dev/null)
  fi

  if [ -z "${repo_path}" ]; then
    echo "No such repo: \"$1\""
  else
    cd "$(dirname "${repo_path}")"
    if [ -n "${VIRTUAL_ENV}" ]; then
      # Exit current virtualenv, if any
      deactivate
    fi
    if type workon &> /dev/null && workon | grep -Fxq "${repo_name}"; then
      # If there is a virtualenvwrapper virtualenv with an exact match, activate it
      workon "${repo_name}"
    elif [ -d venv -a -f venv/bin/activate ]; then
      # If there is a venv folder in the repo and it's a virtualenv, activate it
      source venv/bin/activate
    fi
  fi
}

__switch_repos "$1"
